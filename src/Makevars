## With R 3.1.0 or later, you can uncomment the following line to tell R to
## enable compilation with C++11 (or even C++14) where available
# CXX_STD = CXX11

# Rcpp's debug casts call abort(); use exceptions instead on all platforms.
# Disable Eigen's debug assertions as well.
PKG_CPPFLAGS = -DNDEBUG -DEIGEN_NO_DEBUG

.PHONY: all clean

all: $(SHLIB)

clean:
	$(RM) *.o
	$(RM) *.dll
	$(RM) *.so
	$(RM) *.dylib
